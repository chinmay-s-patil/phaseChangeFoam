FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    fluid_to_heater
    {
        type            calculated;
        value           uniform 101325;
    }

    top
    {
        type            calculated;
        value           uniform 101325;
    }

    walls
    {
        type            calculated;
        value           uniform 101325;
    }
}

