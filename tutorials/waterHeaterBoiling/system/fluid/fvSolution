FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p_rgh.*"
    {
        solver          GAMG;
        tolerance       1e-7;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    "(U|he|Yi).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1;
    }
}

PIMPLE
{
    nOuterCorrectors            4;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    1;
    momentumPredictor           no;
    outerTolerance              1e-4;
}

relaxationFactors
{
    equations
    {
        "U.*"           1.0;
        "he.*"          1.0;
    }
}

