FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     phaseChangeMultiRegionFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3600;      // 1 hour simulation

deltaT          0.1;

writeControl    adjustableTime;

writeInterval   60;        // Save output every 60 seconds

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxDi           1.0;       // Diffusion Courant / Fourier number constraint

maxDeltaT       1.0;

// ************************************************************************* //
