FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/pcm";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "h.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    nNonLinearCorrectors    25;
    nonLinearTolerance      1e-4;
}

