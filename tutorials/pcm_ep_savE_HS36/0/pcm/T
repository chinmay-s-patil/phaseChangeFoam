FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/pcm";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295.15;    // Initial solid PCM temperature: 22 °C (295.15 K)

boundaryField
{
    // Heated bottom surface
    bottom
    {
        type            fixedValue;
        value           uniform 328.15; // 55 °C heating temperature (above 40 °C liquidus)
    }

    // Top surface
    top
    {
        type            zeroGradient;
    }

    // Insulated side walls
    walls
    {
        type            zeroGradient;
    }
}

