#!/bin/sh
cd "${0%/*}" || exit 1

# Check OpenFOAM environment
if [ -z "$WM_PROJECT_DIR" ]; then
    echo "Error: OpenFOAM environment not detected. Please source your OpenFOAM etc/bashrc first." >&2
    exit 1
fi

echo "========================================"
echo " Building phaseChangeFoam Solver Suite"
echo " OpenFOAM: $WM_PROJECT_VERSION"
echo " User Bin: $FOAM_USER_APPBIN"
echo "========================================"

# 1. Build transient multi-region solver
echo "Building phaseChangeMultiRegionFoam..."
( cd src/solvers/phaseChangeMultiRegionFoam && wmake ) || exit 1

# 2. Build steady-state multi-region solver
echo "Building phaseChangeMultiRegionSimpleFoam..."
( cd src/solvers/phaseChangeMultiRegionSimpleFoam && wmake ) || exit 1

# 3. Build dictionary generator utility
echo "Building writePCDict utility..."
( cd src/utilities/writePCDict && wmake ) || exit 1

echo "========================================"
echo " Compilation completed successfully."
echo "========================================"
