FoamFile { version 2.0; format ascii; class dictionary; location "system/fluid"; object fvSolution; }
solvers
{
    "(p|p_rgh).*"
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0.001;
    }
    "(p|p_rgh)Final"
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0;
    }
    "(U|h|rho).*"
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-8;
        relTol 0.001;
    }
    "(U|h|rho)Final"
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-8;
        relTol 0;
    }
    "rho.*"
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0;
    }
}
