FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    hot
    {
        type            patch;
        nFaces          1;
        startFace       99;
    }
    cold
    {
        type            patch;
        nFaces          1;
        startFace       100;
    }
    bottom
    {
        type            empty;
        inGroups        1(empty);
        nFaces          100;
        startFace       101;
    }
    top
    {
        type            empty;
        inGroups        1(empty);
        nFaces          100;
        startFace       201;
    }
    back
    {
        type            empty;
        inGroups        1(empty);
        nFaces          100;
        startFace       301;
    }
    front
    {
        type            empty;
        inGroups        1(empty);
        nFaces          100;
        startFace       401;
    }
)

