FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/pcm";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       100;
    }
    transport
    {
        kappa           1.0;
    }
    thermodynamics
    {
        Cp              2000;
        Hf              0;
    }
    equationOfState
    {
        rho             1000;
    }
}

