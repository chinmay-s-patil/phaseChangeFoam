FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "500/pcm";
    object      heatingTrajectory;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    hot
    {
        type            calculated;
        value           uniform 1;
    }
    cold
    {
        type            calculated;
        value           uniform 1;
    }
    bottom
    {
        type            empty;
    }
    top
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    front
    {
        type            empty;
    }
}


